    "settings.general.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room keeps its history on this Mac, in Room's own folder. It stores sizes, dates and the names of folders you mapped, to show changes over time. It never stores file contents, never sends anything anywhere, and has no account or analytics. Settings › General › Forget history removes it."
          }
        }
      }
    },
