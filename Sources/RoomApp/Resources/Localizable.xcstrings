    "onboarding.p1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your disk is a house. Room draws its plan, shows which rooms are full, and how much room is free."
          }
        }
      }
    },
